# Flyway Database Configuration
# Copy this file to .env and fill in your actual database credentials
# NEVER commit the .env file to version control!

# Local PostgreSQL container provisioning (used by the `postgres` service in docker-compose.yml)
POSTGRES_DB=fin_pulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrongPassword123!

# Database Connection URL
# Format: jdbc:postgresql://<host>:<port>/<database>
# Inside docker-compose, <host> is the "postgres" service name (container-to-container network)
FLYWAY_URL=jdbc:postgresql://postgres:5432/fin_pulse

# Database credentials (used by Flyway; should match POSTGRES_USER / POSTGRES_PASSWORD above)
FLYWAY_USER=postgres
FLYWAY_PASSWORD=YourStrongPassword123!

# Optional: Flyway Teams/Enterprise license key
# FLYWAY_LICENSE_KEY=your-license-key-here

# Optional: Additional PostgreSQL connection properties
# FLYWAY_CONNECT_RETRIES=3
# FLYWAY_CONNECT_RETRIES_INTERVAL=10
