# Flyway Database Configuration
# Copy this file to .env and fill in your actual database credentials
# NEVER commit the .env file to version control!

# Database Connection URL
# Format: jdbc:sqlserver://<host>:<port>;databaseName=<database>;encrypt=true;trustServerCertificate=false
FLYWAY_URL=jdbc:sqlserver://localhost:1433;databaseName=FinPulse;encrypt=true;trustServerCertificate=true

# Database credentials
FLYWAY_USER=sa
FLYWAY_PASSWORD=YourStrongPassword123!

# Optional: Flyway Teams/Enterprise license key
# FLYWAY_LICENSE_KEY=your-license-key-here

# Optional: Additional SQL Server connection properties
# FLYWAY_CONNECT_RETRIES=3
# FLYWAY_CONNECT_RETRIES_INTERVAL=10
