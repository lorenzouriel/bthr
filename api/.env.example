# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Environment
ASPNETCORE_ENVIRONMENT=Production

# API Port
API_PORT=5026

# Database Connection
DB_CONNECTION_STRING=Host=your-server;Port=5432;Database=fin_pulse;Username=postgres;Password=your-password;

# Observability (OTel Collector, see monitor/)
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long
JWT_ISSUER=FinPulse.Api
JWT_AUDIENCE=FinPulse.Api
JWT_EXPIRATION_MINUTES=60