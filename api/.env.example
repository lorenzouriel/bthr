# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Environment
ASPNETCORE_ENVIRONMENT=Production

# API Port
API_PORT=5026

# Database Connection
DB_CONNECTION_STRING=Server=your-server,port;Database=fin_pulse;User Id=sa;Password=your-password;TrustServerCertificate=True;

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long
JWT_ISSUER=FinPulse.Api
JWT_AUDIENCE=FinPulse.Api
JWT_EXPIRATION_MINUTES=60