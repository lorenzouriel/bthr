{
  "uid": "bthr-api-observability",
  "title": "bthr / API",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "bthr"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, environment)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{environment=~\"$environment\", service_name=~\"bthr.Api\"}, service_instance_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "severity",
        "label": "Severity regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "route",
        "label": "Route regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "API",
      "url": "/d/bthr-api-observability?var-environment=${environment}&var-instance=All",
      "keepTime": true,
      "includeVars": false
    },
    {
      "type": "link",
      "title": "PostgreSQL",
      "url": "/d/postgresql-observability?var-environment=${environment}&var-instance=All",
      "keepTime": true,
      "includeVars": false
    },
    {
      "type": "link",
      "title": "Web",
      "url": "/d/bthr-web-observability?var-environment=${environment}&var-instance=All",
      "keepTime": true,
      "includeVars": false
    },
    {
      "type": "link",
      "title": "Monitoring",
      "url": "/d/bthr-monitoring-observability?var-environment=${environment}&var-instance=All",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Reading this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "Readiness 0 = unavailable. Missing series = signal absent or scrape unavailable; check Monitoring. Empty trace/log results can mean no traffic in the selected time range. Database traces are application-observed calls; infrastructure tracing is not enabled."
      }
    },
    {
      "id": 2,
      "title": "Exporter / scrape availability (1 = reachable)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "title": "Dependency readiness (1 = ready)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "title": "Metrics",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "targets": [],
      "options": {}
    },
    {
      "id": 5,
      "title": "Requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id) (rate(http_server_request_duration_seconds_count{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}[5m]))",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "title": "Errors / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\",http_response_status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "title": "HTTP latency p50 (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,service_instance_id) (rate(http_server_request_duration_seconds_bucket{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}[5m])))",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 8,
      "title": "HTTP latency p95 (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service_instance_id) (rate(http_server_request_duration_seconds_bucket{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}[5m])))",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 9,
      "title": "HTTP latency p99 (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le,service_instance_id) (rate(http_server_request_duration_seconds_bucket{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}[5m])))",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 10,
      "title": "GC heap bytes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_gc_last_collection_heap_size_bytes{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 11,
      "title": "GC collections / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dotnet_gc_collections_total{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}[5m])",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 12,
      "title": "Thread pool threads",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_thread_pool_thread_count{environment=~\"$environment\",service_instance_id=~\"$instance\",service_name=~\"bthr.Api\"}",
          "legendFormat": "{{service_name}} {{service_instance_id}} {{status_code}}"
        }
      ],
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 13,
      "title": "Logs",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 84,
        "w": 24,
        "h": 1
      },
      "targets": [],
      "options": {}
    },
    {
      "id": 14,
      "title": "Logs for selected instance",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 85,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\",service_name=~\"bthr.Api\"} | service_instance_id=~\"$instance\" | severity_text=~\"$severity\" | Route=~\"$route\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 15,
      "title": "Traces",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 93,
        "w": 24,
        "h": 1
      },
      "targets": [],
      "options": {}
    },
    {
      "id": 16,
      "title": "Recent traces",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 94,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"bthr.Api\" && resource.environment =~ \"${environment:regex}\" && resource.service.instance.id =~ \"${instance:regex}\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {},
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      }
    },
    {
      "id": 17,
      "title": "Failed traces",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 102,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"bthr.Api\" && resource.environment =~ \"${environment:regex}\" && resource.service.instance.id =~ \"${instance:regex}\" && status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {},
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      }
    },
    {
      "id": 18,
      "title": "Slow traces (> 500 ms)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 110,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"bthr.Api\" && resource.environment =~ \"${environment:regex}\" && resource.service.instance.id =~ \"${instance:regex}\" && duration > 500ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {},
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      }
    }
  ]
}
