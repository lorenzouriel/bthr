# Copy to .env and replace all credential placeholders. Never commit .env.
POSTGRES_PASSWORD=replace-me
MONITOR_DB_PASSWORD=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ENVIRONMENT=Development
API_INSTANCE=api-local
DB_INSTANCE=postgres-local
WEB_INSTANCE=web-local
SERVICE_VERSION=local
METRICS_RETENTION=15d
LOGS_RETENTION=168h
TRACES_RETENTION=24h

# Optional agent overlay (compose.agent.yml):
# TELEGRAM_BOT_TOKEN=<BotFather token>
# TELEGRAM_BOT_USERNAME=<without @>
# TELEGRAM_WEBHOOK_SECRET=<32+ random characters>
# BOT_API_KEY=<different 32+ character secret>
# WEB_PUBLIC_URL=https://your-bthr-site.example
# AI_LOCAL_ONLY=true
# AGENT_TIMEZONE=America/Sao_Paulo
# AGENT_INSTANCE=agent-local
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
